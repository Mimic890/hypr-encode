{
  "schemaVersion": 1,
  "jobs": [
    {
      "jobId": 1,
      "input": "in.mkv",
      "output": "out/in.mkv",
      "preset": "hevc",
      "load": "cpu-heavy",
      "threads": 8,
      "command": [
        "ffmpeg",
        "-hide_banner",
        "-nostdin",
        "-y",
        "-v",
        "error",
        "-progress",
        "pipe:1",
        "-nostats",
        "-threads",
        "8",
        "-i",
        "in.mkv",
        "-map",
        "0:v?",
        "-map",
        "0:a:0",
        "-c",
        "copy",
        "-c:V",
        "libx265",
        "-crf:V",
        "18",
        "-preset:V",
        "medium",
        "-x265-params",
        "pools=8",
        "-c:a",
        "copy",
        "-threads",
        "8",
        "out/in.mkv"
      ]
    },
    {
      "jobId": 2,
      "input": "my clip.mov",
      "output": "out/my clip.mkv",
      "preset": "hevc",
      "load": "cpu-heavy",
      "threads": 8,
      "command": [
        "ffmpeg",
        "-hide_banner",
        "-nostdin",
        "-y",
        "-v",
        "error",
        "-progress",
        "pipe:1",
        "-nostats",
        "-threads",
        "8",
        "-i",
        "my clip.mov",
        "-map",
        "0:v?",
        "-map",
        "0:a:0",
        "-c",
        "copy",
        "-c:V",
        "libx265",
        "-crf:V",
        "18",
        "-preset:V",
        "medium",
        "-x265-params",
        "pools=8",
        "-c:a",
        "copy",
        "-threads",
        "8",
        "out/my clip.mkv"
      ]
    }
  ]
}
